@model CivicConnect.Web.Controllers.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}
<div class="signin">
    <form asp-action="Password" method="post" class="panel panel-body form" novalidate>
        <div>
            <h1>Change password</h1>
            <p class="lead">@User.DisplayName() &middot; @User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</p>
        </div>
        <div class="field">
            <label asp-for="CurrentPassword">Current password</label>
            <input asp-for="CurrentPassword" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword"></span>
        </div>
        <div class="field">
            <label asp-for="NewPassword">New password</label>
            <input asp-for="NewPassword" autocomplete="new-password" />
            <span asp-validation-for="NewPassword"></span>
        </div>
        <div class="field">
            <label asp-for="ConfirmPassword">New password again</label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword"></span>
        </div>
        <button class="button huge" type="submit">Save password</button>
    </form>
</div>
