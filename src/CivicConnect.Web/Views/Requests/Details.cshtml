@model ServiceRequest
@{
    ViewData["Title"] = Model.RequestNumber;
    ViewData["Nav"] = "requests";
    var supervisor = User.IsSupervisor();
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isAssignee = User.IsStaff() && Model.AssignedToId == currentUserId;
    var staffMembers = ViewBag.StaffMembers as IReadOnlyList<ApplicationUser> ?? [];
    var keptNotes = TempData["Notes"] as string;
    var room = FacilityPlan.Find(Model.RoomId);
    const string when = "d MMM yyyy, HH:mm";

    var canAssign = supervisor && Model.Status.IsOpen();
    RequestStatus? step = Model.Status switch
    {
        RequestStatus.Assigned when isAssignee => RequestStatus.InProgress,
        RequestStatus.InProgress when isAssignee => RequestStatus.Resolved,
        RequestStatus.Resolved when supervisor => RequestStatus.Closed,
        _ => null
    };
    string StepLabel(RequestStatus s) => s switch
    {
        RequestStatus.InProgress => "Start work",
        RequestStatus.Resolved => "Mark as fixed",
        _ => "Close request"
    };
    string Who(UserRef? person) => person is null ? "unknown" : person.Id == currentUserId ? "you" : person.Label;
}
<a class="back" asp-action="Index">&larr; @(supervisor ? "All requests" : User.IsStaff() ? "My jobs" : "My requests")</a>

<div class="request-head">
    <h1>@Model.Title</h1>
    <p class="muted">@FacilityPlan.NameOf(Model.RoomId) &middot; @Model.Category?.Name &middot; @Model.RequestNumber</p>
</div>

<div class="status-box @Model.Status.CssClass()">
    <div>
        <span class="status-box-label">Status</span>
        <strong>@Model.Status.Plain()</strong>
        <partial name="_Status" model="Model.Status" />
        @if (Model.AssignedTo is not null)
        {
            <span class="with">With @Who(Model.AssignedTo)</span>
        }
    </div>
    @if (step is { } nextStatus)
    {
        <form asp-action="ChangeStatus" method="post" class="status-form">
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="currentStatus" value="@Model.Status" />
            <input type="hidden" name="newStatus" value="@nextStatus" />
            <label for="notes" class="visually-hidden">Note</label>
            <input type="text" id="notes" name="notes" value="@keptNotes" placeholder="Add a note (optional)" />
            <button class="button huge" type="submit">@StepLabel(nextStatus)</button>
        </form>
    }
</div>

@if (canAssign)
{
    var first = Model.Status == RequestStatus.New;
    <form asp-action="Assign" method="post" class="panel assign-form">
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="currentStatus" value="@Model.Status" />
        <label for="staffId" class="step-label">@(first ? "Who should fix this?" : "Give it to someone else")</label>
        <div class="status-form">
            <select id="staffId" name="staffId" required>
                <option value="">Pick a person</option>
                @foreach (var person in staffMembers.Where(p => p.Id != Model.AssignedToId))
                {
                    <option value="@person.Id">@person.DisplayName</option>
                }
            </select>
            <label for="assignNotes" class="visually-hidden">Note</label>
            <input type="text" id="assignNotes" name="notes" placeholder="Add a note (optional)" />
            <button class="button @(first ? "huge" : "quiet")" type="submit">@(first ? "Assign" : "Reassign")</button>
        </div>
    </form>
}

<ol class="stepper" aria-label="Progress">
    @foreach (var s in RequestStatusText.Lifecycle)
    {
        var css = s < Model.Status ? "done" : s == Model.Status ? "current " + s.CssClass() : null;
        <li class="@css" aria-current="@(s == Model.Status ? "step" : null)">@s.Plain()</li>
    }
</ol>

<div class="split">
    <div>
        <section class="panel section">
            <div class="panel-head"><h2>What happened</h2></div>
            <div class="panel-body">
                <p class="description">@Model.Description</p>
            </div>
        </section>

        <section class="panel section">
            <div class="panel-head"><h2>History</h2></div>
            <div class="panel-body">
                @if (!Model.History.Any())
                {
                    <p class="muted">Nothing yet.</p>
                }
                else
                {
                    <ol class="history">
                        @foreach (var item in Model.History.OrderByDescending(h => h.PerformedAtUtc))
                        {
                            var by = Who(item.PerformedBy);
                            <li class="@item.ToStatus?.CssClass()">
                                <time datetime="@item.PerformedAtUtc.ToString("O")">@item.PerformedAtUtc.ToLocalTime().ToString(when)</time>
                                @switch (item.ActionType)
                                {
                                    case "Submitted":
                                        <span>Sent by @by</span>
                                        break;
                                    case "Assigned":
                                    case "Reassigned":
                                        <span>Given to <strong>@Who(item.AssignedTo)</strong> <span class="muted">by @by</span></span>
                                        break;
                                    default:
                                        <span>Moved to <strong>@item.ToStatus?.Label()</strong> <span class="muted">by @by</span></span>
                                        break;
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Notes))
                                {
                                    <p class="note">@item.Notes</p>
                                }
                            </li>
                        }
                    </ol>
                }
            </div>
        </section>
    </div>

    <aside class="panel">
        <div class="panel-head"><h2>Details</h2></div>
        <div class="panel-body">
            <dl class="facts">
                <dt>Type</dt>
                <dd>@(Model.Category?.Name ?? "-")</dd>
                <dt>Room</dt>
                <dd>
                    @FacilityPlan.NameOf(Model.RoomId)
                    @if (supervisor && room is not null)
                    {
                        <br /><a class="small" asp-action="Map" asp-route-room="@room.Id">Show on map</a>
                    }
                </dd>
                <dt>Priority</dt>
                <dd><span class="priority priority-@Model.Priority.ToString().ToLowerInvariant()">@Model.Priority</span></dd>
                <dt>Assigned to</dt>
                <dd>@(Model.AssignedTo is null ? "Nobody yet" : Who(Model.AssignedTo))</dd>
                <dt>Sent</dt>
                <dd>@Model.CreatedAtUtc.ToLocalTime().ToString(when)</dd>
                <dt>Updated</dt>
                <dd>@Model.UpdatedAtUtc.ToLocalTime().ToString(when)</dd>
            </dl>
        </div>
    </aside>
</div>
