@model ServiceRequest
@{
    ViewData["Title"] = "Request Details";
    var canChangeStatus = User.IsInRole("Staff") || User.IsInRole("Supervisor") || User.IsInRole("Admin");
}
<div class="page-header">
    <div>
        <p class="eyebrow">@Model.RequestNumber</p>
        <h1>@Model.Title</h1>
    </div>
    <span class="status">@Model.Status</span>
</div>
<div class="grid two">
    <section class="card">
        <h2>Request</h2>
        <p><strong>Category:</strong> @Model.Category?.Name</p>
        <p><strong>Priority:</strong> @Model.Priority</p>
        <p><strong>Submitted:</strong> @Model.CreatedAtUtc.ToLocalTime()</p>
        <p><strong>Last updated:</strong> @Model.UpdatedAtUtc.ToLocalTime()</p>
        <p><strong>Description:</strong></p>
        <p>@Model.Description</p>
    </section>
    <section class="card">
        <h2>Feedback</h2>
        @if (!Model.Feedback.Any())
        {
            <p class="muted">No feedback recorded yet.</p>
        }
        else
        {
            foreach (var feedback in Model.Feedback.OrderByDescending(f => f.CreatedAtUtc))
            {
                <div class="timeline-item"><strong>@feedback.CreatedAtUtc.ToLocalTime()</strong><br />@feedback.Message</div>
            }
        }
    </section>
</div>
<section class="card">
    <h2>Attributable history</h2>
    @if (!Model.History.Any())
    {
        <p class="muted">No history entries yet.</p>
    }
    else
    {
        <div class="timeline">
        @foreach (var item in Model.History.OrderByDescending(h => h.PerformedAtUtc))
        {
            <div class="timeline-item">
                <strong>@item.ActionType</strong>
                <span>@item.PerformedAtUtc.ToLocalTime()</span>
                <p>@item.FromStatus → @item.ToStatus</p>
                <small>Performed by: @item.PerformedBy?.Email</small>
                @if (!string.IsNullOrWhiteSpace(item.Notes)) { <p>@item.Notes</p> }
            </div>
        }
        </div>
    }
</section>
@if (canChangeStatus)
{
    <section class="card">
        <h2>Change status</h2>
        <form asp-action="ChangeStatus" method="post" class="form-card compact">
            <input type="hidden" name="id" value="@Model.Id" />
            <label for="newStatus">New status</label>
            <select id="newStatus" name="newStatus" asp-items="Html.GetEnumSelectList<RequestStatus>()"></select>
            <label for="notes">Notes</label>
            <textarea id="notes" name="notes" rows="3"></textarea>
            <button class="button" type="submit">Update status</button>
        </form>
    </section>
}
