@model IReadOnlyList<UserUpdate>
@{
    ViewData["Title"] = "Updates";
    ViewData["Nav"] = "updates";
}
<div class="page-head">
    <h1>Updates</h1>
</div>

@if (Model.Count == 0)
{
    <div class="panel empty">
        <h2>No updates yet</h2>
        <p>When something happens to your requests or jobs, you will see it here.</p>
    </div>
}
else
{
    <ul class="updates">
        @foreach (var update in Model)
        {
            <li>
                <a class="update @(update.Feedback.IsRead ? null : "unread")" asp-action="Details" asp-route-id="@update.Request.Id">
                    @if (!update.Feedback.IsRead)
                    {
                        <span class="new-tag">New</span>
                    }
                    <span class="update-main">
                        <span class="update-message">@update.Feedback.Message</span>
                        <span class="card-meta">@update.Request.Title &middot; @FacilityPlan.NameOf(update.Request.RoomId)</span>
                    </span>
                    <time datetime="@update.Feedback.CreatedAtUtc.ToString("O")">@update.Feedback.CreatedAtUtc.ToLocalTime().ToString("d MMM HH:mm")</time>
                </a>
            </li>
        }
    </ul>
}
