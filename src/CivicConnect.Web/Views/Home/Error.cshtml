@{
    var notFound = ViewBag.Code as int? == 404;
    ViewData["Title"] = notFound ? "Page not found" : "Something went wrong";
}
<div class="panel empty">
    <h1>@ViewData["Title"]</h1>
    <p>@(notFound ? "This page does not exist." : "Please try again.")</p>
    <a class="button" asp-controller="Home" asp-action="Index">Go to home</a>
</div>
