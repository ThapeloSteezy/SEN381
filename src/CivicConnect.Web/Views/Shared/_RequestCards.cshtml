@model IEnumerable<ServiceRequest>
<ul class="cards">
    @foreach (var request in Model)
    {
        <li>
            <a class="card" asp-controller="Requests" asp-action="Details" asp-route-id="@request.Id">
                <span class="card-icon"><partial name="_Icon" model="request.Category?.Name ?? string.Empty" /></span>
                <span class="card-main">
                    <span class="card-title">@request.Title</span>
                    <span class="card-meta">@FacilityPlan.NameOf(request.RoomId) &middot; @request.CreatedAtUtc.ToLocalTime().ToString("d MMM")</span>
                </span>
                <partial name="_Status" model="request.Status" />
            </a>
        </li>
    }
</ul>
